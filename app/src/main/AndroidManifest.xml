<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Used only to refresh the OurAirports vliegveld-/baancatalogus from
        davidmegginson.github.io on an explicit tap. The app works fully offline without it:
        the catalogue ships bundled in the APK, and every calculation is local. The same
        permission will carry the planned online METAR lookup (docs/00-plan.md Fase 2c).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Fase 4a — Real Life Performance (docs/00-plan.md): GPS logging of the take-off roll,
        used only while the app is in the foreground during an active recording. No
        FOREGROUND_SERVICE/POST_NOTIFICATIONS — recording stops the moment the app is
        backgrounded rather than trying to continue in the background.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".Hk36Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Hk36ttc"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hk36ttc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lets the share sheet read a generated export (a calculation PDF, or the user-data
            JSON backup) out of the app's own cache. Android forbids handing a raw file:// URI
            to another app, so this is the required route. Not exported: only apps the user
            explicitly picks from the share sheet get a temporary, per-file read grant.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
