# Template for keystore.properties, which is NOT tracked (see .gitignore).
#
# Copy this file to keystore.properties next to it and fill in the real values, or
# `assembleRelease` produces an unsigned APK that no device will install. Every other Gradle
# task — debug builds, unit tests, connectedAndroidTest — works fine without it.
#
# storeFile is resolved relative to the repository root, so a bare filename means the .jks sits
# beside this file. Keeping the key inside the repo folder is fine precisely because *.jks is
# gitignored; keeping a backup of it somewhere else is not optional. If this key is lost, the
# app can never be updated under the same identity again — a new key means a new app.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=hk36ttc
keyPassword=CHANGE_ME
